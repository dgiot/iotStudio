[Version]
Signature="$CHICAGO$"
provider=%ProviderName%

Class=ZTIC_USB
ClassGUID={4ED68D40-22F3-11d7-B879-0050CF0052C8};// {4ED68D40-22F3-11d7-B879-0050CF0052C8}
                                                ;DEFINE_GUID(<<name>>, 
                                                ;0x4ed68d40, 0x22f3, 0x11d7, 0xb8, 0x79, 0x0, 0x50, 0xcf, 0x0, 0x52, 0xc8);
[ClassInstall]
Addreg=Class_AddReg

[ClassInstall32]
Addreg=Class_AddReg

[Class_AddReg]
HKR,,,,%DeviceClassName%
HKR,,Icon,,"-20"

[Manufacturer]
%HdwrVendor%=HdwrVendor

[HdwrVendor]
%USB\VID_4C51&PID_7310.DeviceDesc%=USB7kCDEV.Dev, USB\VID_4C51&PID_7310
%USB\VID_4C51&PID_7322.DeviceDesc%=USB7kCDEV.Dev, USB\VID_4C51&PID_7322
%USB\VID_4C51&PID_7408.DeviceDesc%=USB7kCDEV.Dev, USB\VID_4C51&PID_7408
%USB\VID_4C51&PID_7503.DeviceDesc%=USB7kCDEV.Dev, USB\VID_4C51&PID_7503
%USB\VID_5A54&PID_7310.DeviceDesc%=USB7kC.Dev, USB\VID_5A54&PID_7310
%USB\VID_5A54&PID_7322.DeviceDesc%=USB7kC.Dev, USB\VID_5A54&PID_7322
%USB\VID_5A54&PID_7408.DeviceDesc%=USB7kC.Dev, USB\VID_5A54&PID_7408
%USB\VID_5A54&PID_7503.DeviceDesc%=USB7kC.Dev, USB\VID_5A54&PID_7503

[DestinationDirs]
USB7kC.Files.Ext = 10,System32\Drivers
USB7kC.Files.Inf = 10,INF
USB7kCDEV.Files.Ext = 10,System32\Drivers
USB7kCDEV.Files.Inf = 10,INF

[USB7kC.Dev]
CopyFiles=USB7kC.Files.Ext, USB7kC.Files.Inf
AddReg=USB7kC.AddReg

[USB7kC.Dev.NT]
CopyFiles=USB7kC.Files.Ext, USB7kC.Files.Inf
AddReg=USB7kC.AddReg

[USB7kC.Dev.NT.Services]
Addservice = USB7kC, 0x00000002, USB7kC.AddService

[USB7kC.AddService]
DisplayName    = %USB7kC.SvcDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 2                  ; SERVICE_AUTO_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\USB7kC.sys
LoadOrderGroup = Base

[USB7kC.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,USB7kC.sys

[USB7kC.Files.Ext]
USB7kC.sys

[USB7kC.Files.Inf]
USB7kC.Inf

[USB7kCDEV.Dev]
CopyFiles=USB7kCDEV.Files.Ext, USB7kCDEV.Files.Inf
AddReg=USB7kCDEV.AddReg

[USB7kCDEV.Dev.NT]
CopyFiles=USB7kCDEV.Files.Ext, USB7kCDEV.Files.Inf
AddReg=USB7kCDEV.AddReg

[USB7kCDEV.Dev.NT.Services]
Addservice = USB7kCDEV, 0x00000002, USB7kCDEV.AddService

[USB7kCDEV.AddService]
DisplayName    = %USB7kCDEV.SvcDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 2                  ; SERVICE_AUTO_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\USB7kC.sys
LoadOrderGroup = Base

[USB7kCDEV.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,USB7kC.sys

[USB7kCDEV.Files.Ext]
USB7kC.sys

[USB7kCDEV.Files.Inf]
USB7kC.Inf
;---------------------------------------------------------------;

[Strings]
ProviderName="北京中泰研创科技有限公司"
HdwrVendor="中泰研创"
DeviceClassName="USB7000系列数据采集卡"
USB\VID_4C51&PID_7310.DeviceDesc="USB7000" 
USB\VID_4C51&PID_7322.DeviceDesc="USB7000" 
USB\VID_4C51&PID_7408.DeviceDesc="USB7000" 
USB\VID_4C51&PID_7503.DeviceDesc="USB7000" 
USB\VID_5A54&PID_7310.DeviceDesc="USB7310" 
USB\VID_5A54&PID_7322.DeviceDesc="USB7322" 
USB\VID_5A54&PID_7408.DeviceDesc="USB7408" 
USB\VID_5A54&PID_7503.DeviceDesc="USB7503"

USB7kC.SvcDesc="USB7kC"
USB7kCDEV.SvcDesc="USB7000C"

