# ============================================================
# pythonIot — 主配置文件
# ============================================================
title: "DG-IoT 轻量物联网平台"
version: "1.0.0"
host: "0.0.0.0"
port: 8000
log_level: "INFO"
data_dir: "./data"
sqlite_path: "./data/local.db"

# 存储模式: "parse" (连接Parse Server) | "sqlite" (单机版)
storage_mode: "sqlite"

db:
  host: "127.0.0.1"
  port: 5432
  user: "postgres"
  password: "YOUR_PASSWORD"
  database: "iot_platform"

tdengine:
  host: "tdengine.example.com"     # edge-dmz 边缘中枢
  port: 6041                 # taosAdapter RESTful
  user: "root"
  password: "YOUR_PASSWORD"
  database: "iot_telemetry"
  # Windows 无 TDengine → 自动降级 SQLite (data/telemetry.db)

# 插件管理 — 启用/禁用协议和服务
plugins:
  protocol:
    modbus_tcp: true
    modbus_rtu: false
    iec104: false
    opcua: false
    a11: true
    http_rest_vendor_oilmon: true
  service:
    collector: true
    alarm_engine: true
    push_engine: true
    phm_engine: true
    safety_rules: true
  storage:
    tdengine: true     # 无则自动降级 SQLite
    sqlite: true       # 始终可用

# 第三方密钥 (敏感信息, 其他配置全部入库 parse_lite Channel 表)
credentials:
  vendor_oilmon_username: "YOUR_USER".com"
  vendor_oilmon_password: "YOUR_PASSWORD"
  oracle_relay_host: "127.0.0.1"
  oracle_relay_user: "administrator"
  oracle_relay_pass: "YOUR_WINRM_PASSWORD"

# Parse-lite (嵌入式 — 替代 Parse Server)
parse:
  db_path: "./data/parse.db"   # SQLite 单机版
  app_id: "<your-app-id>"
  master_key: "<your-master-key>"

mqtt:
  host: "127.0.0.1"
  port: 1883
  username: ""
  password: "YOUR_PASSWORD"
  client_id: "pythonIot-pusher"

# ============================================================
# PHM 云平台 (设备预测性维护)
# ============================================================
phm_platform:
  base_url: "https://test.pubsci.top"
  api_base: "http://localhost:18183"   # 后端 API 内网地址
  realm: "phm"
  client_id: "phm-web"
  username: "qut-admin"
  password: "YOUR_PASSWORD"
  poll_interval: 60

# ============================================================
# A11 协议设备配置 (油气生产物联网)
# 协议栈: ModbusTCP(7B MBAP) + jjZZ(4B) + Type LE(2B) + Sub LE(2B) + Payload
# 参考: A11 正式规范白皮书 V1.0
# ============================================================
# # 远程抓包 — WinRM 连接到边缘服务器
remote_capture:
  host: "127.0.0.1"
  port: 5985
  username: "administrator"
  password: "YOUR_PASSWORD"

a11_devices:
