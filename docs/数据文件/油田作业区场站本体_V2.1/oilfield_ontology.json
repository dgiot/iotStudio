      },
      {
        "level": "L4",
        "rule": "时序一致性",
        "condition": "delta < 50%",
        "severity": "warn",
        "action": "标记可疑值"
      },
      {
        "level": "L5",
        "rule": "Oracle双源对比",
        "condition": "|A-B|/A < 1%",
        "severity": "danger",
        "action": "数据源异常告警"
      }
